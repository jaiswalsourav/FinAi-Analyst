DATABASE_URL=jdbc:postgresql://your-neon-host/neondb?sslmode=require
DATABASE_USERNAME=your_database_username
DATABASE_PASSWORD=your_database_password
GEMINI_API_KEY=your_gemini_api_key
ALPHA_VANTAGE_KEY=your_alpha_vantage_key
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
JWT_EXPIRATION_MS=86400000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Shared secret between the backend and the AI service (generate: python -c "import secrets; print(secrets.token_urlsafe(48))")
INTERNAL_API_KEY=replace_with_a_long_random_secret
# Address the browser uses to reach the backend (change when deploying to a server)
VITE_BACKEND_URL=http://localhost:8080

# First admin account, created at startup if it doesn't exist yet (password at least 8 characters)
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=replace_with_a_strong_password

# Password reset emails. Without SPRING_MAIL_HOST the reset link is only written to the backend log.
# Gmail example: smtp.gmail.com, port 587, your address, and an app password (not your normal password).
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
MAIL_FROM=no-reply@yourcompany.com
# Address of the frontend; the reset email links here
APP_BASE_URL=http://localhost:3000
